    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.72.0",
    "react-router-dom": "^6.22.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
